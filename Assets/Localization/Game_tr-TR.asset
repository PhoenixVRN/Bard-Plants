      m_Items: []
  - m_Id: 2215091557621760
    m_Localized: "\u015Eimdi sipari\u015Fi ilk m\xFC\u015Fterine teslim et!"
    m_Metadata:
      m_Items: []
  - m_Id: 2215221987893248
    m_Localized: "Aferin, ama yard\u0131ma ihtiyac\u0131n olaca\u011F\u0131n\u0131
