    m_Metadata:
      m_Items: []
  - m_Id: 2215285007310848
    m_Localized: "Tan\u0131d\u0131\u011F\u0131m biri var\u2026 ya da yar\u0131m biri
      ^_^"
    m_Metadata:
      m_Items: []
  - m_Id: 2215424929292288
    m_Localized: "Sana yard\u0131m edecek!"
    m_Metadata:
      m_Items: []
  - m_Id: 2215497620774912
    m_Localized: "SELAM! Tamam, sana tarlada yard\u0131m edece\u011Fim!"
    m_Metadata:
      m_Items: []
  - m_Id: 2215560766021632
    m_Localized: "Ama sonra benim de yard\u0131ma ihtiyac\u0131m olacak..."
